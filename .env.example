# AI Office's start-up configuration. Copy to `.env` (git-ignored); every
# value below is set for local development on Windows or macOS with Docker
# Desktop or on Linux, so `cp .env.example .env` is all `pnpm dev` (and
# `docker compose up`) needs; `pnpm dev` copies it if there is no .env.
# `pnpm dev`, `pnpm db:schema` and `docker compose up` all read it.
# Everything else is configured in the admin pages and stored in Postgres.
# An empty value means its default; the few left empty say why.
#
# One entry point: AI Office's address (https://ai-office.localhost in
# `pnpm dev`, and http://localhost:3045, the published app under compose)
# serves the web app, its
# /api and the AI Gateway's /v1 paths. Your own tools use it with a Gateway
# Key from API Key Management: Claude Code with its ANTHROPIC_BASE_URL set
# to http://localhost:3045, OpenAI clients with http://localhost:3045/v1.

# --- Required ---------------------------------------------------------------

# DEVELOPMENT ONLY. These sample secrets are public (they are in this file),
# and the server warns when it starts with them. Once AI Office is served
# beyond this machine (HOST, or AI_OFFICE_BIND_ADDRESS under compose, beyond
# loopback; a PUBLIC_URL other than localhost; or TRUST_PROXY set), it
# refuses to start with them, POSTGRES_PASSWORD included. For anything other
# than local development, generate your own:
#   SESSION_SECRET, at least 32 characters:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   ENCRYPTION_KEY, 32 random bytes, base64-encoded:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To replace ENCRYPTION_KEY (it leaked, or it is still this sample), keep
# what it sealed: move its value, as written, to RETIRED_ENCRYPTION_KEYS
# (below), and set ENCRYPTION_KEY to the new key after the next key version
# and a colon: 2:<new key> for the first replacement, 3:<newer key> for the
# next. Each value is then sealed again with the new key when AI Office
# starts; once its log says RETIRED_ENCRYPTION_KEYS can be removed, remove
# it. Changing ENCRYPTION_KEY any other way makes everything sealed with it
# (AI Account credentials, Agents' Gateway Keys, Connections' credentials,
# the TOTP secret) unreadable.
SESSION_SECRET=development-only-session-secret-change-me
ENCRYPTION_KEY=ZGV2LW9ubHktYWktb2ZmaWNlLWVuY3J5cHRpb24ta3k=
# The keys ENCRYPTION_KEY replaced, separated by commas, each as it was
# written, while what they sealed is sealed again with it (above).
# Left empty: nothing has been replaced.
RETIRED_ENCRYPTION_KEYS=

# --- docker compose ---------------------------------------------------------

# Required by compose: the password of the `ai_office` Postgres user. Use a
# URL-safe value (it goes into a connection URL): openssl rand -hex 24.
# DEVELOPMENT ONLY, and public, like the secrets above; it matches
# DATABASE_URL below. Postgres takes it when it makes its data volume, so to
# change it later, change the user's password too (ALTER USER ai_office
# PASSWORD '...').
POSTGRES_PASSWORD=devpassword
# Where the app is published on the host. Default 127.0.0.1, so only this
# machine can reach it; set 0.0.0.0 to listen on every interface. It opens
# the AI Gateway (/v1) too: every Gateway request needs a Gateway Key, but
# to open AI Office beyond this machine, use the `tls` profile (below).
AI_OFFICE_BIND_ADDRESS=127.0.0.1
# The host port the app, and the AI Gateway's /v1 with it, is published on.
# Default 3045.
AI_OFFICE_PORT=3045
# The `tls` profile (docker compose --profile tls up): the name Caddy serves
# AI Office at over HTTPS, with a certificate it obtains itself, such as
# ai-office.example.com (whose DNS points at this machine). Default
# localhost, with a certificate from Caddy's own local CA. Set PUBLIC_URL to
# https://<this name>, TRUST_PROXY to 1 and PROXY_SECRET with it.
AI_OFFICE_DOMAIN=localhost
# The app container gets the host's Docker socket, for the sandboxes Agents
# work in. Access to it is as good as root on the host. Set this to the ID of
# the group that owns the socket: stat -c %g /var/run/docker.sock (Linux).
# Default 0, which suits Docker Desktop.
DOCKER_GID=0
# Where Agents' and the Manager chat's clones are made under compose, on the
# Docker host. Compose mounts it into the app at the same path, because the
# host's Docker mounts the clones into sandboxes by the path the app gives
# it, and makes it if it is missing, owned by UID 1000 (the app's `node`).
# It takes only a directory it has just made or UID 1000's own, never a
# symbolic link or another user's, so never put it under a directory others
# may write to, such as /tmp, where another local user could make the path
# first. On Linux, any other absolute path. On macOS, a path Docker Desktop
# shares (Settings > Resources > File sharing: /Users is by default). On
# Windows, a Linux-style path, never C:\...: it is a path in Docker
# Desktop's Linux VM. Left empty: ~/.ai-office/sandboxes, in the home
# directory of whoever runs compose (HOME).
AI_OFFICE_SANDBOX_DIR=

# --- pnpm dev (docker-compose.dev.yml) ---------------------------------------
# `pnpm dev` runs every service in Docker and serves AI Office at
# https://ai-office.localhost (browsers send any *.localhost name to this
# machine), with a certificate from Caddy's own local CA: trust its root,
# caddy/pki/authorities/local/root.crt in AI_OFFICE_DEV_CADDY_DIR, once
# (docs/guide/running.md). It sets the server's DATABASE_URL,
# HOST, PORT, PUBLIC_URL, GATEWAY_HOST, GATEWAY_PORT, OAUTH_CALLBACK_HOST,
# SANDBOX_GATEWAY_URL, SANDBOX_NETWORK and SANDBOX_WORK_DIR itself, whatever
# they say below; the rest of this file reaches the server as it is.
# The host ports of the web app, its /api and the AI Gateway's /v1: HTTPS,
# and HTTP, which only redirects to HTTPS. Set others when something else on
# this machine (a reverse proxy, say) has 443 or 80.
# Left empty: 443 and 80.
AI_OFFICE_DEV_HTTPS_PORT=
AI_OFFICE_DEV_HTTP_PORT=
# The address your browser opens AI Office at, if not
# https://ai-office.localhost with AI_OFFICE_DEV_HTTPS_PORT (unless it is
# 443): for a port forwarded from another machine, say.
# Left empty: that address.
AI_OFFICE_DEV_PUBLIC_URL=
# Where the HTTPS proxy keeps its local CA and certificates.
# Left empty: ~/.ai-office/dev-caddy.
AI_OFFICE_DEV_CADDY_DIR=
# The host port ChatGPT's sign-in callback (localhost:1455) is published on.
# Set another when a docker-compose.yml stack on this machine has 1455; then
# paste the address the sign-in ends on back into AI Office.
# Left empty: 1455.
AI_OFFICE_DEV_OAUTH_PORT=
# Where Agents' clones are made, on the Docker host and at the same path in
# the server's container. On Windows, a Linux-style path, never C:\...: it
# is a path in Docker Desktop's Linux VM. Left empty:
# ~/.ai-office/dev-sandboxes, or on Windows /home/ai-office/dev-sandboxes.
AI_OFFICE_DEV_SANDBOX_DIR=
# --- Running the server outside compose --------------------------------------

# The Postgres database, as a postgres:// URL. This one is the development
# database in docker-compose.dev.yml, which `pnpm dev` starts, as the host
# reaches it (`pnpm db:schema`). Compose builds its own from
# POSTGRES_PASSWORD and ignores this, as `pnpm dev` does.
DATABASE_URL=postgres://ai_office:devpassword@127.0.0.1:3048/ai_office
# The server's port. Default 3046. Run by hand, the website is Vite, on
# 3045, which proxies the API to this port.
PORT=3046
# The address the app listens on. Default 127.0.0.1, this machine only;
# 0.0.0.0 for every interface (compose sets it, inside its container).
HOST=127.0.0.1
# Where the app's port is reached from, when that is not HOST: compose sets
# it from AI_OFFICE_BIND_ADDRESS, as HOST is then its container's own. With
# HOST, it says whether AI Office is served beyond this machine.
# Left empty: outside a container, HOST says.
PUBLISHED_ADDRESS=
# The directory the built web app is served from. Left empty: the default,
# apps/web/dist, is found from where the server runs.
WEB_DIST_DIR=

# --- Optional ---------------------------------------------------------------

# The address AI Office is reached at. Default http://localhost:3045.
PUBLIC_URL=http://localhost:3045
# fatal, error, warn, info, debug, trace or silent. Default info.
LOG_LEVEL=info
# Behind a reverse proxy (Caddy, say), which proxies to believe about the
# client's address in X-Forwarded-For: a hop count (1 for one proxy), or a
# comma-separated list of the proxies' addresses and CIDR ranges, as the app
# sees them. Sign-ins are rate-limited per client address, so without this
# every client behind the proxy shares one limit. It is believed only for a
# request that carries PROXY_SECRET, so set both, or neither. Leave both
# empty when nothing is in front of AI Office.
# Left empty: nothing is in front of AI Office in development.
TRUST_PROXY=
# What the proxy sends in the X-AI-Office-Proxy header to prove a request
# came through it: at least 32 characters (openssl rand -hex 32). Under
# compose, Caddy gets the same value and sends it. Anything else that reaches
# the app's port (another container on its network, say) does not hold it, so
# its X-Forwarded-For is never believed, whatever TRUST_PROXY says. The app
# takes it off every request, the AI Gateway's /v1 too.
# Left empty: nothing is in front of AI Office in development.
PROXY_SECRET=

# The AI Gateway's own port: the sandboxes' way to it. (Everything else,
# your own tools included, reaches it at /v1 on AI Office's address.) Every
# request needs a Gateway Key, but it listens on no more than it must:
# loopback, which Docker Desktop's containers reach as host.docker.internal.
# Sandboxes reach it through the sandbox relay (docker-compose.dev.yml),
# which reaches this machine as host.docker.internal. On Linux, set
# GATEWAY_HOST to the docker0 bridge's address (ip -4 addr show docker0,
# usually 172.17.0.1) so the relay reaches it. Compose sets its own and
# never publishes it. Defaults 3047 and 127.0.0.1.
GATEWAY_PORT=3047
GATEWAY_HOST=127.0.0.1
# Recorder mode: write every request/response pair through the Gateway to
# this directory as a contract-test fixture, with credentials redacted.
# Left empty: set, it records every request.
GATEWAY_FIXTURES_DIR=

# ChatGPT's sign-in ends on http://localhost:1455/auth/callback. While one
# waits, AI Office listens there itself, so a browser on this machine
# finishes it without pasting the address back. Compose sets 0.0.0.0 and
# publishes the port to the host's loopback. Default 127.0.0.1.
OAUTH_CALLBACK_HOST=127.0.0.1

# Hosts on your own network, or this machine, that an address you give AI
# Office may name: an AI Account's endpoint (such as your own Ollama), the
# outbound proxy, a Connection's webhook, ntfy server, Confluence site or
# SMTP server, and a Git repository a Skill or Floor Template is imported
# from. Comma-separated names (ollama.lan, which covers its subdomains),
# domains (.lan) or IP addresses, without ports. Any other loopback,
# link-local (the cloud metadata service) or private address, a name such
# as app or postgres, and plain http:// to a host not named here, is
# refused (ADR 0007). It is set here, not in Admin, so a stolen session
# cannot widen it. Your own Ollama is host.docker.internal under `pnpm dev`
# and compose, and localhost for a server run by hand. Left empty: none.
ALLOWED_INTERNAL_HOSTS=

# AI Accounts are not set here: add them in Admin, under AI Accounts. They
# are kept in the database, their credentials encrypted with ENCRYPTION_KEY.
# Until one is added, every Gateway request is a 503.

# Sandboxes, where Agents work issues. Agents start working only once
# SANDBOX_GATEWAY_URL is set (and a GitHub App or access token is added in
# Floor Settings): the AI Gateway's address as a sandbox container reaches
# it, http://sandbox-relay:3047, under compose and outside it alike. Sandboxes reach models only through the Gateway,
# never with an AI Account's credential. The Manager chat runs Claude Code
# or Codex in a sandbox too, which is how a Claude or ChatGPT subscription
# answers it. These three are for a server run by hand, beside a sandbox
# relay that reaches it: `pnpm dev` and compose set SANDBOX_GATEWAY_URL,
# SANDBOX_NETWORK and SANDBOX_WORK_DIR themselves, whatever they say here.
SANDBOX_GATEWAY_URL=http://sandbox-relay:3047
# The Docker network the sandbox relay is on. Default ai-office-sandboxes,
# which docker-compose.yml (or, outside compose, docker-compose.dev.yml)
# creates with no route out. Each sandbox is started on a network of its
# own, as closed, which AI Office joins the relay to as sandbox-relay and
# removes after it: a sandbox reaches only the relay, and no other sandbox.
# Name another only if the relay is on it and it is as closed; never
# Docker's default bridge, which has a route out.
SANDBOX_NETWORK=ai-office-sandboxes
# The hosts sandboxes may reach over HTTPS, through the sandbox relay's proxy
# (port 443 only), separated by commas: names, or *.domain for every name
# under domain. Nothing else on the internet or the local network is
# reachable, and never the instance metadata service. Each host you add is
# one an injected Agent can send what it read to, if it has an account
# there. These two let Agents install npm packages and read their issue
# with gh; empty means none.
SANDBOX_EGRESS_HOSTS=registry.npmjs.org,api.github.com
# Where Agents' clones are made on the host. Docker bind-mounts them into the
# sandboxes, so it must be the same path for AI Office and the Docker host
# (compose uses AI_OFFICE_SANDBOX_DIR, above). Left empty: the default,
# ai-office-sandboxes in the system's temporary directory, differs between
# Windows, macOS and Linux.
SANDBOX_WORK_DIR=

# GitHub Apps and access tokens are not set here: add them in Floor
# Settings, under GitHub (the README's "Setting up a Floor" says how to
# create them). They are kept in the database, the private keys and tokens
# encrypted with ENCRYPTION_KEY. Until one is added, Floors cannot be added
# and Agents do not work.
# GitHub's REST API. Default https://api.github.com; set it for GitHub
# Enterprise Server (https://<host>/api/v3).
GITHUB_API_URL=https://api.github.com
