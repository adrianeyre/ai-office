# The pen-test stack's settings (docs/pen-testing/stack.md). Copy to
# docker/pen-test/.env, which is git-ignored, or let `stand-up` copy it.
# Every value here is empty on purpose: the stack never runs on a value
# from a file in the repository.

# --- Set by the Owner ---------------------------------------------------------

# The pen-test stack's own GitHub App, never the real Office's, installed
# only on the throwaway target repository. Its numeric ID, and its private
# key (on one line, with \n for each newline).
PEN_TEST_GITHUB_APP_ID=
PEN_TEST_GITHUB_APP_PRIVATE_KEY=
# The throwaway target repository, as owner/name.
PEN_TEST_TARGET_REPOSITORY=

# --- Generated by stand-up when empty ---------------------------------------

# The stack's own secrets: stand-up writes new random ones here and refuses
# any that the real stack's .env or the root .env.example also holds.
# Teardown empties them, so each stand-up gets new ones.
PEN_TEST_POSTGRES_PASSWORD=
PEN_TEST_SESSION_SECRET=
PEN_TEST_ENCRYPTION_KEY=
# Where Agents' clones are made, at the same path on the host and in the
# app. Default: ai-office-pen-test/sandboxes under $XDG_STATE_HOME
# (~/.local/state). Never inside this repository, and never the real
# stack's SANDBOX_WORK_DIR. Teardown deletes it.
PEN_TEST_SANDBOX_WORK_DIR=
# Where docker/pen-test/credentials writes the red team's credentials
# package (docs/pen-testing/credentials-package.md), 0600 in a directory
# 0700. Default: ai-office-pen-test/credentials under $XDG_STATE_HOME.
# Never inside this repository or the sandbox work directory, which the
# sandboxes reach. Teardown deletes it.
PEN_TEST_CREDENTIALS_DIR=

# --- Reach ------------------------------------------------------------------

# Where the app is published on the host. Default 127.0.0.1, so only this
# machine reaches it. To open it to the red team's host, set the address of
# one of this machine's interfaces (never 0.0.0.0 or ::), set
# PEN_TEST_RED_TEAM_ADDRESS, and allow only that address in the firewall,
# as docs/pen-testing/stack.md says.
PEN_TEST_BIND_ADDRESS=
# The host port the app is published on. Default 3145.
PEN_TEST_PORT=
# The red team's address, required when PEN_TEST_BIND_ADDRESS is not
# loopback. stand-up prints the firewall rules that admit it alone.
PEN_TEST_RED_TEAM_ADDRESS=
# The address the red team reaches the app at. Default
# http://localhost:<PEN_TEST_PORT>, or http://<PEN_TEST_BIND_ADDRESS>:<port>.
PEN_TEST_PUBLIC_URL=
# The hosts the stack's sandboxes may reach over HTTPS, through the sandbox
# relay (SANDBOX_EGRESS_HOSTS in the root .env.example): names, or
# *.domain, separated by commas. Default none, so a sandbox reaches only the
# AI Gateway.
PEN_TEST_SANDBOX_EGRESS_HOSTS=
# TRUST_PROXY and PROXY_SECRET for the app, to probe it as the deployment
# docs configure it: set both, or neither. Default empty.
PEN_TEST_TRUST_PROXY=
PEN_TEST_PROXY_SECRET=

# --- Set by stand-up from the machine when empty ----------------------------

# The user and group the app runs as, which own the sandbox work directory.
# Default the user running stand-up.
PEN_TEST_UID=
PEN_TEST_GID=
# The group that owns the host's Docker socket. Default on Linux its group,
# as /var/run/docker.sock has it; elsewhere 0, which suits Docker Desktop.
PEN_TEST_DOCKER_GID=
