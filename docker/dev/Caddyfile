# `pnpm dev`'s HTTPS (docker-compose.dev.yml's `proxy`): https://ai-office.localhost
# with a certificate from Caddy's own local CA, in front of Vite, which proxies
# /api, /health and the AI Gateway's /v1 to the server. Plain HTTP only
# redirects to it. Caddy runs as the user running `pnpm dev`, so it listens on
# unprivileged ports, which compose publishes on 443 and 80
# (AI_OFFICE_DEV_HTTPS_PORT and AI_OFFICE_DEV_HTTP_PORT). The CA's root
# certificate, to trust in your browser, is
# caddy/pki/authorities/local/root.crt in AI_OFFICE_DEV_CADDY_DIR.
{
	admin off
	# Caddy cannot install its root in the host's trust store from a
	# container; trust it yourself (docs/guide/running.md).
	skip_install_trust
	# The redirect below names the public address, published port and all.
	auto_https disable_redirects
	http_port 8080
	https_port 8443
}

https://ai-office.localhost {
	tls internal
	# Vite's hot reload (a WebSocket) and the Gateway's server-sent events
	# pass through as they are; the browser's Host header is kept.
	reverse_proxy web:3045
}

http://ai-office.localhost {
	redir {$AI_OFFICE_DEV_PUBLIC_URL}{uri} permanent
}
